# Copy to .env and adjust. Used by docker-compose.override.yml.

# Admin password for the CyberRange app (and the forwarder's login).
CR_ADMIN_PASSWORD=change-me-strong

# Wazuh image version — MUST match the single-node stack fetched by setup.sh.
WAZUH_VERSION=4.9.0

# Optional: use Supabase/Postgres instead of the app's SQLite file.
# DATABASE_URL=postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres?sslmode=require
